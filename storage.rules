rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function activeMember(groupId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /prayer-photos/{groupId}/{dateKey}/{userId}/{fileName} {
      allow read: if activeMember(groupId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && activeMember(groupId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }

    match /group-logos/{groupId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
